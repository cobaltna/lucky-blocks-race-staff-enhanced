              {
                "weight": 100,
                "add": { "component_groups": [ "butcher", "behavior_non_peasant" ] }
              },
              {
                "weight": 0,
                "add": { "component_groups": [ "leatherworker", "behavior_non_peasant" ] }
              }
            ]
          }
        ]
