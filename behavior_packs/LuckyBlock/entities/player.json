            "queue_command": { "command": [ "tag @s add snowman_head", "title @s actionbar §lCrouch to activate skill" ] }
          }
        ]
      },
      "stop_snowman_head_event": {
        "sequence": [
          {
            "filters": { "test": "has_tag", "subject": "self", "operator": "==", "value": "snowman_head" },
            "queue_command": { "command": [ "tag @s remove snowman_head" ] },
            "remove": { "component_groups": [ "snowman_head_attack" ] }
          }
        ]
      },
