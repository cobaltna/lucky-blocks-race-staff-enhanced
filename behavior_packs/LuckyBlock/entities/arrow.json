{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:arrow",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "start_despawn_arrow": {
        "minecraft:despawn": {
          "filters": { "all_of": [ { "test": "is_family", "subject": "self", "value": "bone_sword_arrow" } ] } }
      },
      "despawn_arrow": {
        "minecraft:type_family": { "family": [ "bone_sword_arrow", "effect99_entities" ] },
        "minecraft:timer": { "time": [ 1, 1 ], "looping": false,
        "time_down_event": { "event": "start_despawn_arrow", "target": "self" } 
        }
      },
      "family:arrow": { "minecraft:type_family": { "family": [ "arrow" ] } },
      "minecraft:inertia_disable": {
        "minecraft:projectile": {
          "on_hit": {
            "impact_damage": {
              "damage": 1,
              "knockback": true,
              "semi_random_diff_damage": true,
              "destroy_on_hit": true,
              "max_critical_damage": 10,
              "min_critical_damage": 9,
              "power_multiplier": 0.97
            },
            "stick_in_ground": {
              "shake_time" : 0.35
            },
            "arrow_effect": {
            }
          },
          "hit_sound": "bow.hit",
          "power": 0,
          "gravity": 1,
          "inertia": 0,
          "liquid_inertia": 0,
          "uncertainty_base": 1,
          "uncertainty_multiplier": 0,
          "anchor": 1,
          "should_bounce": true,
          "offset": [ 0, -0.1, 0 ]
        }
      },
      "minecraft:hard_arrow": {
        "minecraft:type_family": { "family": [ "arrow" ] },
        "minecraft:projectile": {
          "on_hit": {
            "impact_damage": {
              "damage": [ 1, 5 ],
              "knockback": true,
              "semi_random_diff_damage": false,
              "destroy_on_hit": true
            },
            "stick_in_ground": {
              "shake_time" : 0.35
            },
            "arrow_effect": {
            }
          },
          "hit_sound": "bow.hit",
          "power": 1.6,
          "gravity": 0.05,
          "uncertainty_base": 16,
          "uncertainty_multiplier": 4,
          "anchor": 1,
          "should_bounce": true,
          "offset": [ 0, -0.1, 0 ]
        }
      },
      "minecraft:player_arrow": {
        "minecraft:type_family": { "family": [ "arrow" ] },
        "minecraft:projectile": {
          "on_hit": {
            "impact_damage": {
              "damage": 1,
              "knockback": true,
              "semi_random_diff_damage": true,
              "destroy_on_hit": true,
              "max_critical_damage": 10,
              "min_critical_damage": 9,
              "power_multiplier": 0.97
            },
            "stick_in_ground": {
              "shake_time" : 0.35
            },
            "arrow_effect": {
            }
          },
          "hit_sound": "bow.hit",
          "power": 5.0,
          "gravity": 0.05,
          "uncertainty_base": 1,
          "uncertainty_multiplier": 0,
          "anchor": 1,
          "should_bounce": true,
          "offset": [ 0, -0.1, 0 ]
        }
      },
      "minecraft:pillager_arrow": {
        "minecraft:type_family": { "family": [ "arrow" ] },
        "minecraft:projectile": {
          "on_hit": {
            "impact_damage": {
              "damage": [ 3, 6 ],
              "knockback": true,
              "semi_random_diff_damage": false,
              "destroy_on_hit": true
            },
            "stick_in_ground": {
              "shake_time": 0.35
            },
            "arrow_effect": {
            }
          },
          "hit_sound": "bow.hit",
          "power": 1.6,
          "gravity": 0.05,
          "uncertainty_base": 16,
          "uncertainty_multiplier": 4,
          "anchor": 1,
          "should_bounce": true,
          "offset": [ 0, -0.1, 0 ]
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.25,
        "height": 0.25
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:projectile": {
        "on_hit": {
          "impact_damage": {
            "damage": [ 1, 4 ],
            "knockback": true,
            "semi_random_diff_damage": false,
            "destroy_on_hit": true
          },
          "stick_in_ground": {
            "shake_time" : 0.35
          },
          "arrow_effect": {
          }
        },
        "hit_sound": "bow.hit",
        "power": 1.6,
        "gravity": 0.05,
        "uncertainty_base": 16,
        "uncertainty_multiplier": 4,
        "anchor": 1,
        "should_bounce": true,
        "offset": [ 0, -0.1, 0 ]
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "filters": {"test": "is_difficulty", "value": "hard"},
            "add": {
              "component_groups": [ "minecraft:hard_arrow" ]
            }
          },
          {
            "filters": {"test": "is_family", "subject": "other", "value": "player"},
            "add": {
              "component_groups" : [ "minecraft:player_arrow" ]
            }
          },
          {
            "filters": { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "effect:bone_sword" },
            "add": {
              "component_groups" : [ "despawn_arrow" ]
            }
          },
          {
            "filters": {"test": "is_family", "subject": "other", "value": "pillager"},
            "add": {
              "component_groups": [ "minecraft:pillager_arrow" ]
            }
          },
          {
            "filters": {"test": "is_family", "subject": "other", "value": "skeleton"},
            "add": {
              "component_groups": [ "family:arrow" ]
            }
          }
        ]
      },
      "start_despawn_arrow": { "add": { "component_groups": [ "start_despawn_arrow" ] } 
      },
      "minecraft:inertia_disable": {
        "remove": { "component_groups": [ "minecraft:player_arrow", "minecraft:pillager_arrow", "minecraft:hard_arrow", "family:arrow" ] },
        "add": { "component_groups": [ "minecraft:inertia_disable" ] }
      }
    }
  }
}